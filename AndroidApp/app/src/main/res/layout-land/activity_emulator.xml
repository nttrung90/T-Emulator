<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emulatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Fullscreen Game View (Aspect Ratio Preserved at Center) -->
    <ImageView
        android:id="@+id/gameScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- 2. Overlay Virtual Gamepad Controls (Full Screen, Transparent Background) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gamepadArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <!-- Top Floating Utility Controls (Center-aligned, subtle & compact) -->
        <LinearLayout
            android:id="@+id/topBarLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/topBarRight"
            app:layout_constraintHorizontal_chainStyle="packed">

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textColor="#90CAF9"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_settings"
                    android:textColor="#E3F2FD"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Turbo Button -->
            <TextView
                android:id="@+id/btnTurbo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:text="⏩ Turbo"
                android:textColor="#FFCA28"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Rewind Button -->
            <TextView
                android:id="@+id/btnRewind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/btn_rewind"
                android:textColor="#EF5350"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Top Right Utility Controls (Screenshot & FPS) -->
        <LinearLayout
            android:id="@+id/topBarRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginStart="6dp"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/topBarLeft"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- PiP Button -->
            <TextView
                android:id="@+id/btnPip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:text="⧉"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:contentDescription="@string/btn_pip"
                android:clickable="true"
                android:focusable="true" />

            <!-- Screenshot Button -->
            <TextView
                android:id="@+id/btnScreenshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:text="📸"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- FPS counter -->
            <TextView
                android:id="@+id/tvFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_settings_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="60 FPS"
                android:textColor="#80D8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ==================== LEFT SIDE CONTROLS ==================== -->
        <!-- L Shoulder Button (Top-Left) -->
        <TextView
            android:id="@+id/btnL"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_button"
            android:text="L"
            android:contentDescription="@string/desc_btn_l"
            android:textColor="#ECEFF1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- D-Pad (Bottom-Left) -->
        <ImageView
            android:id="@+id/dpad"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/dpad_bg"
            android:contentDescription="@string/desc_dpad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <!-- ==================== RIGHT SIDE CONTROLS ==================== -->
        <!-- R Shoulder Button (Top-Right) -->
        <TextView
            android:id="@+id/btnR"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_button"
            android:text="R"
            android:contentDescription="@string/desc_btn_r"
            android:textColor="#ECEFF1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center Hub Anchor for Action Buttons (Bottom-Right) -->
        <View
            android:id="@+id/actionHub"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            android:layout_marginEnd="96dp"
            android:layout_marginBottom="92dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <!-- Action Button X (Top - Blue) -->
        <TextView
            android:id="@+id/btnX"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_action_x"
            android:text="X"
            android:contentDescription="@string/desc_btn_x"
            android:textColor="#90CAF9"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/actionHub"
            app:layout_constraintStart_toStartOf="@id/actionHub"
            app:layout_constraintEnd_toEndOf="@id/actionHub" />

        <!-- Action Button B (Bottom - Yellow) -->
        <TextView
            android:id="@+id/btnB"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_action_b"
            android:text="B"
            android:contentDescription="@string/desc_btn_b"
            android:textColor="#FFE082"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/actionHub"
            app:layout_constraintStart_toStartOf="@id/actionHub"
            app:layout_constraintEnd_toEndOf="@id/actionHub" />

        <!-- Action Button Y (Left - Green) -->
        <TextView
            android:id="@+id/btnY"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_action_y"
            android:text="Y"
            android:contentDescription="@string/desc_btn_y"
            android:textColor="#A5D6A7"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toStartOf="@id/actionHub"
            app:layout_constraintTop_toTopOf="@id/actionHub"
            app:layout_constraintBottom_toBottomOf="@id/actionHub" />

        <!-- Action Button A (Right - Red) -->
        <TextView
            android:id="@+id/btnA"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_action_a"
            android:text="A"
            android:contentDescription="@string/desc_btn_a"
            android:textColor="#EF9A9A"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/actionHub"
            app:layout_constraintTop_toTopOf="@id/actionHub"
            app:layout_constraintBottom_toBottomOf="@id/actionHub" />

        <!-- NES / GB / GBA Action Buttons -->
        <!-- NES Button B (Bottom-Left - Retro Crimson) -->
        <TextView
            android:id="@+id/btnNesB"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_action_nes_b"
            android:text="B"
            android:contentDescription="@string/desc_btn_b"
            android:textColor="#FFCDD2"
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/actionHub"
            app:layout_constraintTop_toTopOf="@id/actionHub" />

        <!-- NES Button A (Bottom-Right - Retro Crimson) -->
        <TextView
            android:id="@+id/btnNesA"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_action_nes_a"
            android:text="A"
            android:contentDescription="@string/desc_btn_a"
            android:textColor="#FFCDD2"
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/actionHub"
            app:layout_constraintBottom_toBottomOf="@id/actionHub" />

        <!-- NES Button Turbo B (Top-Left, above B - Gold/Amber) -->
        <TextView
            android:id="@+id/btnNesTb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_action_nes_tb"
            android:text="TB"
            android:contentDescription="@string/desc_btn_turbo_b"
            android:textColor="#FFE082"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnNesB"
            app:layout_constraintStart_toStartOf="@id/btnNesB"
            app:layout_constraintEnd_toEndOf="@id/btnNesB" />

        <!-- NES Button Turbo A (Top-Right, above A - Gold/Amber) -->
        <TextView
            android:id="@+id/btnNesTa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_action_nes_ta"
            android:text="TA"
            android:contentDescription="@string/desc_btn_turbo_a"
            android:textColor="#FFE082"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnNesA"
            app:layout_constraintStart_toStartOf="@id/btnNesA"
            app:layout_constraintEnd_toEndOf="@id/btnNesA" />

        <!-- ==================== BOTTOM CENTER CONTROLS (SELECT, MENU, START) ==================== -->
        <!-- SELECT Button -->
        <TextView
            android:id="@+id/btnSelect"
            android:layout_width="66dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/pill_button"
            android:text="SELECT"
            android:contentDescription="@string/desc_btn_select"
            android:textColor="#CFD8DC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnMenu"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <!-- MENU Button -->
        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/pill_button"
            android:text="@string/btn_menu"
            android:contentDescription="@string/desc_btn_menu"
            android:textColor="#90CAF9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnSelect"
            app:layout_constraintEnd_toStartOf="@+id/btnStart" />

        <!-- START Button -->
        <TextView
            android:id="@+id/btnStart"
            android:layout_width="66dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill_button"
            android:text="START"
            android:contentDescription="@string/desc_btn_start"
            android:textColor="#CFD8DC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnMenu"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
