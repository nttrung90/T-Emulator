<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#901E88E5" />
            <stroke android:width="3dp" android:color="#90CAF9" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#D01A1F2C" />
            <stroke android:width="2.5dp" android:color="#42A5F5" />
        </shape>
    </item>
</selector>
