<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#B0C62828" />
            <stroke android:width="3dp" android:color="#EF9A9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E01C1924" />
            <stroke android:width="2.5dp" android:color="#E53935" />
        </shape>
    </item>
</selector>
