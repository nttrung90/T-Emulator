<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#B0F57F17" />
            <stroke android:width="3dp" android:color="#FFF59D" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E0211E16" />
            <stroke android:width="2.5dp" android:color="#FFB300" />
        </shape>
    </item>
</selector>
