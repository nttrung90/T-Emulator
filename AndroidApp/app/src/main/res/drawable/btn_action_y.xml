<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#9043A047" />
            <stroke android:width="3dp" android:color="#A5D6A7" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#D01A1F2C" />
            <stroke android:width="2.5dp" android:color="#66BB6A" />
        </shape>
    </item>
</selector>
